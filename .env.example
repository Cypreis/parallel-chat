# Copy this file to .env (which is git-ignored) and fill in what you use.
# Keys can also be added in the web app (provider settings); a key added there
# lives in memory, or in .keys.json (also git-ignored) when you ask it to be
# remembered. A key from the app wins over .keys.json, which wins over this file.
# With no key the app starts without a model and asks for one in Settings.

# Anthropic: when set, the server starts on it.
ANTHROPIC_API_KEY=

# OpenCode (Zen / Console, opencode.ai), DeepSeek and Qwen (Alibaba Cloud
# Model Studio): selectable in the app. ChatGPT needs no key: sign in from Settings.
OPENCODE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
# A local OpenAI-compatible server (Ollama: http://localhost:11434/v1)
# LOCAL_LLM_URL=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Qwen keys are bound to one region: intl (Singapore, default), us, cn, hk.
# DASHSCOPE_REGION=intl

# Optional settings (the defaults are shown).
# PC_MODEL=claude-opus-5-5
# PC_MODE=fanout
# PC_MAX_CARDS=6
# PORT=4317
# HOST=127.0.0.1
# Chats and settings survive a restart in .data/ (log.jsonl, config.json; no keys).
# Move it with a path (relative to this folder), or keep everything in memory with off:
# PC_DATA_DIR=.data
# PC_DATA_DIR=off
